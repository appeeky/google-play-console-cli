{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter \"@appeeky/google-play-store-server...\" build",
    "watchPatterns": [
      "packages/core/**",
      "packages/mcp/**",
      "packages/server/**",
      "package.json",
      "pnpm-lock.yaml",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node packages/server/dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
