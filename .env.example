# Multi-account config (~/.config/gps/config.json)
#
# One SA key is NOT limited to one app: Play Console can grant the same SA
# access to many packages. Google Publisher API still has no list-apps method,
# so register packages you care about locally.

{
  "defaultAccount": "phosum",
  "accounts": {
    "phosum": {
      "credentialsPath": "/absolute/path/to/phosum-sa.json",
      "defaultPackage": "com.phosum",
      "apps": [
        { "packageName": "com.phosum", "displayName": "Phosum" },
        { "packageName": "com.other.app", "displayName": "Other" }
      ]
    },
    "client-acme": {
      "credentialsPath": "/absolute/path/to/acme-sa.json",
      "defaultPackage": "com.acme.app",
      "apps": [
        { "packageName": "com.acme.app", "displayName": "Acme" }
      ]
    }
  }
}
